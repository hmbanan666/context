# Compose reads .env when passed with --env-file. Node does not auto-load it.
# See README for settings; the URL is required and areas are optional.
CONTEXT_PUBLIC_URL=https://context.example/mcp
CONTEXT_AREAS=personal,projects,inbox
TZ=UTC
CONTEXT_BACKUP_AT=03:30
CONTEXT_BACKUP_KEEP=7
CONTEXT_BACKUP_TARGET=none
# Required when adding -f deploy/dokploy.yaml (Traefik / Dokploy):
# CONTEXT_HOST=context.example
# CONTEXT_PROXY_NETWORK=existing-context-proxy
# Optional S3/SFTP target variables are also passed through; see README.
