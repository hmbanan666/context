# Export variables in your shell; .env is not auto-loaded.
NODE_ENV=development
CONTEXT_PORT=3000
CONTEXT_DB_PATH=./data/context.db
CONTEXT_AREAS=personal
# Fictional local development only; never expose remotely.
# CONTEXT_LOCAL_MCP=enabled
# Protected mode: remove local opt-in and configure HTTPS.
# CONTEXT_AUTH=oauth
# CONTEXT_PUBLIC_URL=https://context.example/mcp
# CONTEXT_REFRESH_SECONDS=86400
# CONTEXT_OFFLINE_SECONDS=2592000
# Initialize the owner and issue client tokens through `npm run context -- ...`.
# Keep original legacy area names in CONTEXT_AREAS for existing records.

# Automatic SQLite backups (independent of authentication/provider configuration).
# Export variables; this file is not loaded automatically.
CONTEXT_BACKUP_DIR=./backups
CONTEXT_BACKUP_AT=03:30
# IANA timezone; default is the process/server timezone (usually UTC in containers).
# CONTEXT_BACKUP_TIMEZONE=Europe/Berlin
CONTEXT_BACKUP_KEEP=7
# none = local only; s3 or sftp enables an off-host copy of the verified snapshot.
CONTEXT_BACKUP_TARGET=none
# Whole upload deadline: 1000–3600000 ms. Set CONTEXT_BACKUP_AT=off to disable scheduling.
CONTEXT_BACKUP_TIMEOUT_MS=300000
# S3-compatible storage: existing private bucket, HTTPS endpoint, path-style requests.
# CONTEXT_BACKUP_S3_ENDPOINT=https://s3.example.invalid
# CONTEXT_BACKUP_S3_REGION=us-east-1
# CONTEXT_BACKUP_S3_BUCKET=fictional-context-backups
# CONTEXT_BACKUP_S3_PREFIX=context/
# CONTEXT_BACKUP_S3_ACCESS_KEY=<set privately>
# CONTEXT_BACKUP_S3_SECRET_KEY=<set privately>
# SFTP: existing private absolute remote directory and mounted, unencrypted private key.
# CONTEXT_BACKUP_SFTP_HOST=sftp.example.invalid
# CONTEXT_BACKUP_SFTP_PORT=22
# CONTEXT_BACKUP_SFTP_USER=backup-owner
# CONTEXT_BACKUP_SFTP_PRIVATE_KEY_PATH=/run/secrets/backup_key
# CONTEXT_BACKUP_SFTP_REMOTE_DIR=/backups/context
# Required SHA-256 of the SSH host public-key blob as 64 hex digits (not base64).
# Obtain through a trusted channel; there is no trust-on-first-use fallback.
# CONTEXT_BACKUP_SFTP_HOST_KEY_SHA256=<verified 64-hex fingerprint>
