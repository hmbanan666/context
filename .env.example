# These are defaults. Export variables in your shell; .env is not auto-loaded.
NODE_ENV=development
CONTEXT_PORT=3000
CONTEXT_DB_PATH=./data/context.db
# Explicit local-only no-auth opt-in. Synthetic data only; never expose remotely.
# CONTEXT_LOCAL_MCP=synthetic
# CONTEXT_LOCAL_SCOPES=synthetic:local-foundation
# Protected pilot: use all four settings together and remove local no-auth settings.
# CONTEXT_AUTH=oauth
# CONTEXT_PUBLIC_URL=https://context.kosarev.space/mcp
# CONTEXT_OAUTH_ISSUER=https://context.kosarev.space/auth/realms/context
# CONTEXT_OWNER_SUBJECT=actual-owner-user-id-from-Keycloak
# Optional operator grants; signed tokens must independently contain operation and data scopes.
# Missing clients in this map have no access. Processing requires an explicit process grant.
# CONTEXT_CLIENT_GRANTS='{"context-chatgpt":{"read":["synthetic:project-a","synthetic:project-b"],"write":["synthetic:project-a","synthetic:project-b"],"process":["synthetic:project-a"]},"context-codex":{"read":["synthetic:project-a"],"write":[],"process":[]}}'
