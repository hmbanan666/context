# New install. Copy to .env next to compose.yaml. Compose reads it for
# interpolation. Do not commit .env. An existing host should keep its
# current area list rather than replace it with the single area below.

# Required. Public HTTPS URL of this instance, path exactly /mcp.
# Keep it stable after a client connects. Replace the hostname.
CONTEXT_PUBLIC_URL=https://context.example/mcp

# Access boundaries, comma-separated, at most eight. One area is enough.
CONTEXT_AREAS=personal

# Time zone for the nightly backup clock. UTC is the image default.
TZ=UTC

# Search grounding. Defaults are a starting point. Fractions from 0 to 1.
# Lexical strong is the uncommon-term share that must match.
# Lexical none is the share below which a weak margin is none.
# Margin is best evidence cosine minus the area or project centroid.
# Weak must be <= strong. Calibrate margin with `context grounding explain --file`.
# CONTEXT_GROUNDING_LEXICAL_STRONG=0.5
# CONTEXT_GROUNDING_LEXICAL_NONE=0.30
# CONTEXT_GROUNDING_MARGIN_WEAK=0.024
# CONTEXT_GROUNDING_MARGIN_STRONG=0.08

# The processor stays off until both a model and an API key are set.
# Capture, search, read, and timeline do not need one.
# See docs/llm-providers.md.
# CONTEXT_PROCESSOR=openai
# CONTEXT_LLM_BASE_URL=https://api.openai.com/v1
# CONTEXT_LLM_API_KEY=
# CONTEXT_LLM_MODEL=
# Optional. Force distilled sentences and weekly journals into one language.
# Unset follows the source. A journal otherwise uses the majority of its items.
# CONTEXT_DISTILL_LANGUAGE=ru

# Database file on the data volume. Leave unset: /app/data/context.db.
# CONTEXT_DB_PATH=/app/data/context.db

# Listen port inside the container. Leave unset and change the host port
# in compose.yaml if 3000 is taken.
# CONTEXT_PORT=3000

# Nightly SQLite backups on the same volume. Target none keeps them local.
# CONTEXT_BACKUP_DIR=/app/data/backups
# CONTEXT_BACKUP_AT=03:30
# CONTEXT_BACKUP_KEEP=7
# CONTEXT_BACKUP_TARGET=none

# S3 target. Set CONTEXT_BACKUP_TARGET=s3 and fill these in.
# CONTEXT_BACKUP_S3_ENDPOINT=https://s3.example/v1
# CONTEXT_BACKUP_S3_REGION=example
# CONTEXT_BACKUP_S3_BUCKET=context-backups
# CONTEXT_BACKUP_S3_PREFIX=context/
# CONTEXT_BACKUP_S3_ACCESS_KEY=
# CONTEXT_BACKUP_S3_SECRET_KEY=

# SFTP target. Set CONTEXT_BACKUP_TARGET=sftp. The key file also needs a
# read-only mount; a path alone does not mount it.
# CONTEXT_BACKUP_SFTP_HOST=sftp.example
# CONTEXT_BACKUP_SFTP_PORT=22
# CONTEXT_BACKUP_SFTP_USER=context
# CONTEXT_BACKUP_SFTP_PRIVATE_KEY_PATH=/run/secrets/backup_key
# CONTEXT_BACKUP_SFTP_REMOTE_DIR=/private/context
# CONTEXT_BACKUP_SFTP_HOST_KEY_SHA256=

# Accepted and unused. The public URL turns OAuth on.
# CONTEXT_AUTH=oauth

# Loopback synthetic mode. Forbidden when CONTEXT_PUBLIC_URL is set and
# forbidden in production. Leave unset.
# CONTEXT_LOCAL_MCP=enabled

# Traefik overlay only (deploy/dokploy.yaml). Not used by compose.yaml.
# CONTEXT_HOST=context.example
# CONTEXT_PROXY_NETWORK=proxy

# Codex processor only. Personal, and not this compose file.
# See docs/llm-providers.md and docs/deployment.md.
# CONTEXT_CODEX_BIN=
# CONTEXT_CODEX_HOME=
# CODEX_HOME=
