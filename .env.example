# Export variables in your shell; .env is not auto-loaded.
NODE_ENV=development
CONTEXT_PORT=3000
CONTEXT_DB_PATH=./data/context.db
CONTEXT_AREAS=personal
# Explicit loopback-only no-auth opt-in. Fictional data only; never expose remotely.
# CONTEXT_LOCAL_MCP=enabled
# Protected mode: remove local opt-in and configure every OAuth setting below.
# CONTEXT_AUTH=oauth
# CONTEXT_PUBLIC_URL=https://context.kosarev.space/mcp
# CONTEXT_OAUTH_ISSUER=https://context.kosarev.space/auth/realms/context
# CONTEXT_OWNER_SUBJECT=owner-user-id-from-Keycloak
# CONTEXT_AREAS=personal,garden
# Every grant must name a configured area. Tokens independently need the same
# area and operation scopes. Missing clients have no access; no implicit grants.
# CONTEXT_CLIENT_GRANTS='{"context-chatgpt":{"read":["personal","garden"],"write":["personal","garden"],"process":[]},"context-codex":{"read":["garden"],"write":[],"process":[]}}'
# For old databases, explicitly retain their original area names in CONTEXT_AREAS,
# client grants and provider scopes. Startup never moves records to personal.
