# Export variables in your shell; .env is not auto-loaded.
NODE_ENV=development
CONTEXT_PORT=3000
CONTEXT_DB_PATH=./data/context.db
CONTEXT_AREAS=personal
# Fictional local development only; never expose remotely.
# CONTEXT_LOCAL_MCP=enabled
# Protected mode: remove local opt-in and configure HTTPS.
# CONTEXT_AUTH=oauth
# CONTEXT_PUBLIC_URL=https://context.example/mcp
# CONTEXT_REFRESH_SECONDS=86400
# CONTEXT_OFFLINE_SECONDS=2592000
# Initialize the owner and issue client tokens through `npm run context -- ...`.
# Keep original legacy area names in CONTEXT_AREAS for existing records.
