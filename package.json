{
  "name": "context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "seed:synthetic": "node dist/scripts/seed-synthetic.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=3 dist/test/*.test.js",
    "test:smoke": "npm run build && node --test dist/test/restart.test.js",
    "inspect:smoke": "npm run build && node dist/scripts/inspect-local.js",
    "database": "node dist/scripts/database.js",
    "memory:process": "node dist/scripts/process-memory.js",
    "test:container": "python3 scripts/container-smoke.py",
    "eval:context-package": "npm run build && node dist/test/evaluate-context-package.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "context": "node dist/scripts/context.js",
    "test:oauth": "npm run build && node --test dist/test/oauth.test.js",
    "backup": "node dist/scripts/backup.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.0.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "bin": {
    "context": "dist/scripts/context.js"
  }
}
