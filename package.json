{
  "name": "context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "lint": "vp check --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && TZ=UTC vp test",
    "database": "node dist/scripts/database.js",
    "memory:process": "node dist/scripts/process-memory.js",
    "test:container": "python3 scripts/container-smoke.py",
    "eval:context-package": "pnpm run build && node dist/test/evaluate-context-package.js",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "context": "node dist/scripts/context.js",
    "backup": "node dist/scripts/backup.js",
    "eval:retrieval": "pnpm run build && node dist/test/evaluate-retrieval.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.0.0",
    "snowball-stemmers-js": "3.1.2",
    "ssh2": "1.17.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "bin": {
    "context": "dist/scripts/context.js"
  }
}
