{
  "name": "context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "seed:synthetic": "node dist/scripts/seed-synthetic.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:smoke": "npm run build && node --test dist/test/restart.test.js",
    "inspect:smoke": "npm run build && node dist/scripts/inspect-local.js",
    "database": "node dist/scripts/database.js",
    "knowledge:review": "node dist/scripts/review-knowledge.js",
    "work": "node dist/scripts/work.js",
    "work:probe": "node dist/scripts/probe-work.js",
    "memory:process": "node dist/scripts/process-memory.js",
    "test:oauth-provider": "npm run build && python3 scripts/keycloak-smoke.py",
    "test:container": "python3 scripts/container-smoke.py",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  }
}
