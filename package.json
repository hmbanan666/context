{
  "name": "context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc",
    "start": "node dist/src/main.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && TZ=UTC node --test --test-concurrency=3 dist/test/*.test.js",
    "database": "node dist/scripts/database.js",
    "memory:process": "node dist/scripts/process-memory.js",
    "test:container": "python3 scripts/container-smoke.py",
    "eval:context-package": "npm run build && node dist/test/evaluate-context-package.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "context": "node dist/scripts/context.js",
    "backup": "node dist/scripts/backup.js",
    "eval:retrieval": "npm run build && node dist/test/evaluate-retrieval.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.0.0",
    "snowball-stemmers-js": "3.1.2",
    "ssh2": "1.17.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "bin": {
    "context": "dist/scripts/context.js"
  }
}
